
import React, { useEffect, useMemo, useState } from "react";
/**
 * Flexible Work Timesheet
 * - 15‑minute increments
 * - Allowed time range: 07:00–19:00
 * - Lunch fixed 30 min
 * - Auto‑save to LocalStorage
 * - Carry‑forward total balance across all weeks
 * - Export current week to CSV and Excel (.xls)
 * - Prevent Finish < Start (auto-correct)
 */
export default function TimesheetApp() {
  const DAILY_HOURS = 7.25;
  const LUNCH_HOURS = 0.5;
  const STORAGE_KEY = "flex_timesheet_v2";


  // ✅ Generate 15‑minute time options (07:00–19:00 only)
  const timeOptions = useMemo(
    () =>
      Array.from({ length: (19 - 7) * 4 + 1 }, (_, i) => {
        const minutes = 7 * 60 + i * 15;
        const h = String(Math.floor(minutes / 60)).padStart(2, "0");
        const m = String(minutes % 60).padStart(2, "0");
        return `${h}:${m}`;
      }),
    []
  );
  const todayISO = () => new Date().toISOString().split("T")[0];
  const emptyRow = () => ({ date: todayISO(), start: "", finish: "" });
  // --- State (loaded from LocalStorage if present)
  const [weeks, setWeeks] = useState(() => [[emptyRow()]]);
  const [currentWeek, setCurrentWeek] = useState(0);
  const [notice, setNotice] = useState("");
  // --- Load from LocalStorage on first mount
  useEffect(() => {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return;
      const parsed = JSON.parse(raw);
      if (!parsed || !Array.isArray(parsed.weeks)) return;
      setWeeks(parsed.weeks.length ? parsed.weeks : [[emptyRow()]]);
      setCurrentWeek(
        typeof parsed.currentWeek === "number" ? Math.min(parsed.currentWeek, parsed.weeks.length - 1) : 0
      );
    } catch {
      // ignore corrupted storage
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);
  // --- Auto-save to LocalStorage whenever weeks/currentWeek changes
  useEffect(() => {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify({ weeks, currentWeek }));
    } catch {
      // storage could be full or blocked; ignore
    }
  }, [weeks, currentWeek]);
  const rows = weeks[currentWeek] || [];
  const parseTime = (t) => {
    if (!t) return null;
    const [h, m] = t.split(":").map(Number);
    if (Number.isNaN(h) || Number.isNaN(m)) return null;
    return h + m / 60;
  };

  // --- Update helpers
  const updateRow = (index, field, value) => {
    setWeeks((prev) => {
      const next = prev.map((w) => [...w]);
      const row = { ...next[currentWeek][index], [field]: value };
      // Prevent Finish < Start automatically
      const s = parseTime(row.start);
      const f = parseTime(row.finish);
      if (s != null && f != null && f < s) {
        row.finish = row.start; // snap finish up to start
        setNotice("Finish time cannot be earlier than start time. Adjusted automatically.");
        window.clearTimeout(updateRow._t);
        updateRow._t = window.setTimeout(() => setNotice(""), 3000);
      }
      // If start is changed to be after existing finish, also snap finish
      const s2 = parseTime(row.start);
      const f2 = parseTime(row.finish);
      if (s2 != null && f2 != null && f2 < s2) {
        row.finish = row.start;
      }


      next[currentWeek][index] = row;
      return next;
    });
  };


  const addRow = () => {
    setWeeks((prev) => {
      const next = prev.map((w) => [...w]);
      next[currentWeek] = [...(next[currentWeek] || []), emptyRow()];
      return next;
    });
  };


  const deleteRow = (index) => {
    setWeeks((prev) => {
      const next = prev.map((w) => [...w]);
      const w = [...(next[currentWeek] || [])];
      w.splice(index, 1);
      next[currentWeek] = w.length ? w : [emptyRow()];
      return next;
    });
  };


  const startNextWeek = () => {
    setWeeks((prev) => [...prev, [emptyRow()]]);
    setCurrentWeek((prev) => prev + 1);
  };

  const resetAll = () => {
    if (!confirm("Reset all saved timesheet data?")) return;
    localStorage.removeItem(STORAGE_KEY);
    setWeeks([[emptyRow()]]);
    setCurrentWeek(0);
  };


  // --- Calculations
  const computedWeeks = useMemo(() => {
    return weeks.map((weekRows) => {
      const computedRows = (weekRows || []).map((r) => {
        const start = parseTime(r.start);
        const finish = parseTime(r.finish);
        const rawWorked = start != null && finish != null ? finish - start - LUNCH_HOURS : 0;
        const worked = Math.max(0, rawWorked);
        const delta = worked - DAILY_HOURS;
        return { ...r, worked, delta };
      });
      const weekBalance = computedRows.reduce((sum, r) => sum + r.delta, 0);
      return { rows: computedRows, weekBalance };
    });
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [weeks]);


  const currentComputed = computedWeeks[currentWeek] || { rows: [], weekBalance: 0 };
  const weeklyBalance = currentComputed.weekBalance;
  const totalBalance = computedWeeks.reduce((sum, w) => sum + w.weekBalance, 0);


  // Carry-forward balance BEFORE this week (history)
  const carryIn = computedWeeks.slice(0, currentWeek).reduce((sum, w) => sum + w.weekBalance, 0);
  const carryOut = carryIn + weeklyBalance;


  // --- Export
  const formatForCSV = (value) => {
    const s = String(value ?? "");
    // Escape quotes and wrap if needed
    const needsWrap = /[",
]/.test(s);
    const escaped = s.replace(/"/g, '""');
    return needsWrap ? `"${escaped}"` : escaped;
  };



  const exportWeekCSV = () => {
    const header = ["Date", "Start", "Finish", "Lunch (hrs)", "Worked (hrs)", "Daily +/- (hrs)"];
    const lines = [header.map(formatForCSV).join(",")];

    currentComputed.rows.forEach((r) => {
      lines.push(
        [
          r.date,
          r.start,
          r.finish,
          LUNCH_HOURS.toFixed(2),
          r.worked.toFixed(2),
          r.delta.toFixed(2),
        ]
          .map(formatForCSV)
          .join(",")
      );
    });

    lines.push("");
    lines.push(formatForCSV("Weekly balance (hrs)") + "," + weeklyBalance.toFixed(2));
    lines.push(formatForCSV("Carry-in (hrs)") + "," + carryIn.toFixed(2));
    lines.push(formatForCSV("Carry-out (hrs)") + "," + carryOut.toFixed(2));
    lines.push(formatForCSV("Total balance (hrs)") + "," + totalBalance.toFixed(2));
    lines.push(formatForCSV("Carry-out (hrs) ") + "," + carryOut.toFixed(2));


const blob = new Blob([lines.join("
")], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const blob = new Blob([lines.join("
")], { type: "text/csv;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `timesheet_week_${currentWeek + 1}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  };


  // Excel export via HTML table (.xls) – opens in Excel/Numbers/Sheets
  const exportWeekExcel = () => {
    const rowsHtml = currentComputed.rows
      .map(
        (r) =>
          `<tr>` +
          `<td>${r.date || ""}</td>` +
          `<td>${r.start || ""}</td>` +
          `<td>${r.finish || ""}</td>` +
          `<td>${LUNCH_HOURS.toFixed(2)}</td>` +
          `<td>${r.worked.toFixed(2)}</td>` +
          `<td>${r.delta.toFixed(2)}</td>` +
          `</tr>`
      )
      .join("");


    const html = `\
<html>\
<head>\
<meta charset="utf-8" />\
</head>\
<body>\
  <table border="1">\
    <thead>\
      <tr>\
        <th>Date</th><th>Start</th><th>Finish</th><th>Lunch (hrs)</th><th>Worked (hrs)</th><th>Daily +/- (hrs)</th>\
      </tr>\
    </thead>\
    <tbody>\
      ${rowsHtml}\
    </tbody>\
  </table>\
  <br />\
  <table border="1">\
    <tbody>\
      <tr><td>Weekly balance (hrs)</td><td>${weeklyBalance.toFixed(2)}</td></tr>\
      <tr><td>Carry-in (hrs)</td><td>${carryIn.toFixed(2)}</td></tr>\
      <tr><td>Carry-out (hrs)</td><td>${carryOut.toFixed(2)}</td></tr>\
      <tr><td>Total balance (hrs)</td><td>${totalBalance.toFixed(2)}</td></tr>\
    </tbody>\
  </table>\
</body>\
</html>`;


    const blob = new Blob([html], { type: "application/vnd.ms-excel;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `timesheet_week_${currentWeek + 1}.xls`;
    a.click();
    URL.revokeObjectURL(url);
  };


  // --- Preview troubleshooting hints:
  // If your preview is blank, it is usually due to missing Tailwind setup or the file not being used as App.jsx.
  // See guidance in chat response.


  return (
    <div className="min-h-screen bg-gradient-to-br from-indigo-50 via-sky-50 to-emerald-50 p-4">
      <div className="max-w-5xl mx-auto bg-white rounded-2xl shadow-xl p-4 sm:p-6">
        <div className="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
          <div>
            <h1 className="text-2xl font-bold text-slate-800">Flexible Work Timesheet</h1>
            <p className="text-slate-500">15‑minute precision · 07:00–19:00 · Auto‑saved</p>
          </div>
          <div className="flex flex-wrap gap-2">
            <button onClick={startNextWeek} className="px-4 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl shadow">
              New Week
            </button>
            <button onClick={exportWeekCSV} className="px-4 py-2 bg-slate-800 hover:bg-slate-900 text-white rounded-xl shadow">
              Export CSV
            </button>
            <button onClick={exportWeekExcel} className="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow">
              Export Excel
            </button>
            <button onClick={resetAll} className="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white rounded-xl shadow">
              Reset
            </button>
          </div>
        </div>

        {notice ? (
          <div className="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-2 text-amber-900">
            {notice}
          </div>
        ) : null}


        <div className="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div className="flex items-center gap-2">
            <span className="text-slate-600 font-medium">Week</span>
            <select
              value={currentWeek}
              onChange={(e) => setCurrentWeek(Number(e.target.value))}
              className="rounded-xl border px-3 py-2"
            >
              {weeks.map((_, i) => (
                <option key={i} value={i}>
                  Week {i + 1}
                </option>
              ))}
            </select>
          </div>


          <div className="grid grid-cols-2 sm:grid-cols-4 gap-2 text-sm">
            <div className="rounded-xl bg-slate-50 border p-3">
              <div className="text-slate-500">Carry‑in</div>
              <div className={`font-bold ${carryIn < 0 ? "text-rose-600" : "text-emerald-700"}`}>
                {carryIn >= 0 ? "+" : ""}{carryIn.toFixed(2)}h
              </div>
            </div>
            <div className="rounded-xl bg-slate-50 border p-3">
              <div className="text-slate-500">This week</div>
              <div className={`font-bold ${weeklyBalance < 0 ? "text-rose-600" : "text-emerald-700"}`}>
                {weeklyBalance >= 0 ? "+" : ""}{weeklyBalance.toFixed(2)}h
              </div>
            </div>
            <div className="rounded-xl bg-slate-50 border p-3">
              <div className="text-slate-500">Carry‑out</div>
              <div className={`font-bold ${carryOut < 0 ? "text-rose-600" : "text-emerald-700"}`}>
                {carryOut >= 0 ? "+" : ""}{carryOut.toFixed(2)}h
              </div>
            </div>
            <div className="rounded-xl bg-slate-50 border p-3">
              <div className="text-slate-500">Total balance</div>
              <div className={`font-bold ${totalBalance < 0 ? "text-rose-600" : "text-emerald-700"}`}>
                {totalBalance >= 0 ? "+" : ""}{totalBalance.toFixed(2)}h
              </div>
            </div>
          </div>
        </div>


        {/* Desktop / tablet table */}
        <div className="hidden sm:block mt-5">
          <table className="w-full text-sm overflow-hidden rounded-xl">
            <thead className="bg-slate-100">
              <tr>
                {["Date", "Start", "Finish", "Worked", "Daily +/‑", ""].map((h) => (
                  <th key={h} className="p-3 text-left text-slate-600 font-semibold">
                    {h}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {currentComputed.rows.map((r, i) => (
                <tr key={i} className="border-b last:border-0 hover:bg-slate-50 transition">
                  <td className="p-2">
                    <input
                      type="date"
                      value={r.date}
                      onChange={(e) => updateRow(i, "date", e.target.value)}
                      className="rounded-lg border px-2 py-1 focus:ring-2 focus:ring-indigo-200"
                    />
                  </td>
                  <td className="p-2">
                    <select
                      value={r.start}
                      onChange={(e) => updateRow(i, "start", e.target.value)}
                      className="rounded-lg border px-2 py-1 bg-white"
                    >
                      <option value="">--</option>
                      {timeOptions.map((t) => (
                        <option key={t} value={t}>
                          {t}
                        </option>
                      ))}
                    </select>
                  </td>
                  <td className="p-2">
                    <select
                      value={r.finish}
                      onChange={(e) => updateRow(i, "finish", e.target.value)}
                      className="rounded-lg border px-2 py-1 bg-white"
                    >
                      <option value="">--</option>
                      {timeOptions.map((t) => (
                        <option key={t} value={t}>
                          {t}
                        </option>
                      ))}
                    </select>
                  </td>
                  <td className="p-2 font-medium whitespace-nowrap">{r.worked.toFixed(2)} hrs</td>
                  <td className={`p-2 font-semibold whitespace-nowrap ${r.delta < 0 ? "text-rose-600" : "text-emerald-700"}`}>
                    {r.delta >= 0 ? "+" : ""}{r.delta.toFixed(2)}
                  </td>
                  <td className="p-2 text-right">
                    <button
                      onClick={() => deleteRow(i)}
                      className="px-3 py-1 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700"
                      title="Delete row"
                    >
                      Delete
                    </button>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* Mobile card layout */}
        <div className="sm:hidden mt-5 space-y-3">
          {currentComputed.rows.map((r, i) => (
            <div key={i} className="border rounded-2xl p-3 shadow-sm bg-white">
              <div className="flex items-center justify-between gap-2">
                <input
                  type="date"
                  value={r.date}
                  onChange={(e) => updateRow(i, "date", e.target.value)}
                  className="w-full rounded-lg border px-2 py-1"
                />
                <button
                  onClick={() => deleteRow(i)}
                  className="shrink-0 px-3 py-2 rounded-xl bg-slate-100 text-slate-700"
                >
                  Del
                </button>
              </div>


              <div className="grid grid-cols-2 gap-2 mt-2">
                <select value={r.start} onChange={(e) => updateRow(i, "start", e.target.value)} className="rounded-lg border px-2 py-2 bg-white">
                  <option value="">Start</option>
                  {timeOptions.map((t) => (
                    <option key={t} value={t}>
                      {t}
                    </option>
                  ))}
                </select>
                <select value={r.finish} onChange={(e) => updateRow(i, "finish", e.target.value)} className="rounded-lg border px-2 py-2 bg-white">
                  <option value="">Finish</option>
                  {timeOptions.map((t) => (
                    <option key={t} value={t}>
                      {t}
                    </option>
                  ))}
                </select>
              </div>


              <div className="mt-3 flex justify-between text-sm">
                <span className="text-slate-700">Worked: <strong>{r.worked.toFixed(2)}h</strong></span>
                <span className={r.delta < 0 ? "text-rose-600 font-semibold" : "text-emerald-700 font-semibold"}>
                  {r.delta >= 0 ? "+" : ""}{r.delta.toFixed(2)}h
                </span>
              </div>
            </div>
          ))}
        </div>

        <div className="mt-5 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-3">
          <button
            onClick={addRow}
            className="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl shadow"
          >
            + Add day
          </button>

          <p className="text-xs text-slate-500">
            Standard day 7.25h · Lunch 30 min deducted · Strict 15‑minute increments · 07:00–19:00 only
          </p>
        </div>
      </div>
    </div>
  );
}
